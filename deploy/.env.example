# 复制为 .env 后再改。不要把填好的 .env 提交进仓库。
# 脚本：deploy/attach.sh（在 Linux 上跑，产出 ELF 并注册到月弦）

# --- 接哪几个服务（脚本跑完后自动注册到月弦）---
REGISTER_NIGHTINGALE=true
REGISTER_JENKINS=true
REGISTER_POSTGRES=false
REGISTER_MYSQL=false
REGISTER_HOST_LOGS=false

# --- 月弦在哪（可全空，脚本会自己找）---
# YLUNE_HOME=/data/YLuneMCPHub
# YLUNE_CONTAINER=ylune
# YLUNE_URL=http://127.0.0.1:3000
# 控制台当前管理员密码。不填则尝试读月弦 deploy/.env 的 ADMIN_PASSWORD（只对首次口令有效）
# YLUNE_USER=admin
# YLUNE_PASSWORD=
# 覆盖挂载目录。不填则：看容器 /opt/mcp → 月弦 .env 的 MCP_MOUNT_DIR → /data/ylune-mcp
# MCP_MOUNT_DIR=/data/ylune-mcp

# --- 夜莺（REGISTER_NIGHTINGALE=true 时必填 Token）---
# 月弦在 Docker、夜莺在本机：用 host.docker.internal，不要 127.0.0.1
N9E_BASE_URL=http://host.docker.internal:17000
N9E_TOKEN=
N9E_TOOLSETS=alerts,targets,datasource,busi_groups,metrics,logs

# --- Jenkins ---
JENKINS_URL=http://host.docker.internal:8080
JENKINS_USER=mcp-readonly
JENKINS_API_TOKEN=
JENKINS_MCP_TIMEOUT=90s

# --- PostgreSQL（REGISTER_POSTGRES=true）---
# 清单和 pgpass 写到挂载目录；已有文件默认不覆盖（OVERWRITE_PG_CONFIG=true 才覆盖）
PG_TARGET_NAME=app
PG_HOST=host.docker.internal
PG_PORT=5432
PG_DBNAME=yourdb
PG_USER=mcp_ro
PG_SSLMODE=disable
PG_PASSWORD=
# OVERWRITE_PG_CONFIG=false

# --- MySQL（REGISTER_MYSQL=true）---
MYSQL_TARGET_NAME=app
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DBNAME=yourdb
MYSQL_USER=mcp_ro
MYSQL_SSLMODE=disable
MYSQL_PASSWORD=
# OVERWRITE_MYSQL_CONFIG=false

# --- 主机日志（REGISTER_HOST_LOGS=true）---
# 默认不要打开：月弦容器通常没有 ssh 客户端和你们的私钥。
# 本服务更适合笔记本 stdio。若确要注册，先把 host-logs-targets.json
# 放到私有挂载目录；可填主机 password，只有密钥方式需要容器里有 ssh。

# --- 编译（打包脚本和 attach 共用）---
# GOPROXY=https://goproxy.cn,direct
# GO_IMAGE=golang:1.26-bookworm
# GOARCH=amd64
